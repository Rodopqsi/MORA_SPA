{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: API + Web (full stack)",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^([^\\s].*)\\((\\d+|\\d+,\\d+|\\d+,\\d+,\\d+,\\d+)\\):\\s+(error|warning|info)\\s+(TS\\d+)\\s*:\\s*(.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "\\bCompiled successfully\\b|\\bCompiled with\\b\\s+\\d+\\s+(error|warning)"
        }
      }
    },
    {
      "label": "Dev: API",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:api"],
      "isBackground": true,
      "problemMatcher": "$tsc-watch"
    },
    {
      "label": "Dev: Web",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev:web"],
      "isBackground": true,
      "problemMatcher": ["$tsc-watch", "$next-dev"]
    }
  ]
}
